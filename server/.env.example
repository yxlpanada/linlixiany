# 邻里集 后端配置示例（复制为 .env 生效）
# 各服务默认 mock 演示模式；接入真实服务商时改为 real 并填入密钥

PORT=3399

# ---- 短信（腾讯云SMS）----
SMS_MODE=mock
TC_SECRET_ID=
TC_SECRET_KEY=
SMS_SDK_APPID=
SMS_SIGN=
SMS_TEMPLATE_ID=

# ---- 微信登录（微信开放平台）----
WECHAT_MODE=mock
WECHAT_APPID=
WECHAT_SECRET=

# ---- 身份证OCR（腾讯云OCR）----
OCR_MODE=mock

# ---- 公安实名核验 ----
POLICE_MODE=mock
