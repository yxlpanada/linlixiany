.form { display: block; }
.field { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #eef0f2; }
.lbl { width: 160rpx; font-size: 28rpx; color: #333; }
.field .input { flex: 1; background: #f4f5f7; border-radius: 12rpx; padding: 16rpx; font-size: 28rpx; }
.picker { flex: 1; font-size: 28rpx; color: #333; padding: 16rpx 0; }
.row3 { display: flex; gap: 14rpx; margin: 20rpx 0; }
.row3 .input { flex: 1; background: #f4f5f7; border-radius: 12rpx; padding: 16rpx; font-size: 26rpx; }
.tip { margin-top: 24rpx; font-size: 24rpx; color: #9aa0a6; }
