.login { padding: 80rpx 48rpx; text-align: center; }
.logo { font-size: 120rpx; }
.brand { font-size: 52rpx; font-weight: 700; margin-top: 10rpx; }
.sub { color: #9aa0a6; font-size: 26rpx; margin: 12rpx 0 50rpx; }
.tabs { display: flex; justify-content: center; gap: 40rpx; margin-bottom: 30rpx; }
.tab { color: #9aa0a6; font-size: 30rpx; padding-bottom: 10rpx; }
.tab.on { color: #07c160; font-weight: 600; border-bottom: 4rpx solid #07c160; }
.row { gap: 16rpx; align-items: stretch; }
.code { flex: 1; }
.code-btn { width: 220rpx; margin: 0 0 18rpx; padding: 0; font-size: 26rpx; border-radius: 14rpx; }
.wx { margin-top: 20rpx; }
.tip { margin-top: 24rpx; font-size: 24rpx; color: #ff8f00; }
