<view wx:if="{{item}}">
  <image wx:if="{{item.cover}}" class="hero" src="{{item.cover}}" mode="aspectFill"/>
  <view class="card">
    <view class="title">{{item.title}}</view>
    <view class="price" wx:if="{{item.deal==='bid'}}">¥{{item.price}}</view>
    <view class="price" wx:elif="{{item.deal==='swap'}}">换：{{item.want}}</view>
    <view class="price" wx:else>免费送 🎁</view>
    <view class="meta">
      <text class="tag cat">{{item.emoji}} {{item.catName}}</text>
      <text class="tag">成色：{{item.condName}}</text>
      <text class="tag {{item.deal}}">{{item.dealEmoji}} {{item.dealName}}</text>
    </view>
    <view class="divider"></view>
    <view class="desc">{{item.desc || '主人很懒，没写描述～'}}</view>
  </view>

  <view class="card seller">
    <view class="flex center between">
      <view>
        <view class="title">{{item.ownerMask}} <text class="muted">· {{item.building}}栋{{item.unit}}单元{{item.room}}室</text></view>
        <view class="muted">信用分 {{item.owner_credit || '—'}} · {{item.time}}</view>
      </view>
      <button class="btn ghost sm" wx:if="{{!isOwner}}" bindtap="contact">联系</button>
    </view>
  </view>

  <view class="card" wx:if="{{isOwner}}">
    <view class="title" style="margin-bottom:16rpx;">收到的意向（{{offers.length}}）</view>
    <view wx:for="{{offers}}" wx:key="id" class="offer">
      <view class="flex between"><text>{{item.bidder}}</text><text class="muted">{{item.time}}</text></view>
      <view class="line">{{item.line}}</view>
      <view class="muted" wx:if="{{item.message}}">“{{item.message}}”</view>
      <view class="flex" style="margin-top:12rpx;gap:16rpx;">
        <button class="btn sm" data-id="{{item.id}}" bindtap="accept">接受成交</button>
        <button class="btn ghost sm" data-id="{{item.id}}" bindtap="reject">拒绝</button>
      </view>
    </view>
    <view wx:if="{{offers.length===0}}" class="muted">还没有邻居出价，再等等～</view>
  </view>

  <view style="height:160rpx;"></view>
  <view class="bar" wx:if="{{!isOwner}}">
    <button class="btn flex1" bindtap="act">{{item.deal==='bid'?'出价认领':item.deal==='swap'?'发起交换':'免费领取'}}</button>
  </view>
  <view class="bar" wx:else>
    <button class="btn ghost flex1" bindtap="contact">和意向邻居聊聊</button>
  </view>
</view>
